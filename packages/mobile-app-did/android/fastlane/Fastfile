#android/fastlane/Fastlane
# get version name
LARK_WEBHOOK_URL = ENV['LARK_WEBHOOK_URL']
TAG_PREFIX = "eoa.android.app.v."

def get_version_name(file_path)
  gradle_file = File.read(file_path)
  version_name_match = gradle_file.match(/versionName\s+["']([\d.]+)["']/)
  if version_name_match
    return version_name_match[1]
  else
    UI.user_error!("Could not find versionName in #{file_path}")
  end
end

# get time stamp
def get_timestamp
  Time.now.strftime("%Y-%m-%d %H:%M:%S")
end

# the last commit id & commit msg
def get_latest_commit
  commit_id = `git log -1 --pretty=format:"%H"`.strip
  commit_message = `git log -1 --pretty=format:"%s"`.strip
  { id: commit_id, message: commit_message }
end

# get latest and previous tag
def get_latest_and_previous_tag
  begin
    UI.message("Fetching tag list...")

    tags_output = sh("git tag")
    UI.message("All tags in repo:\n#{tags_output}")
    tags = tags_output.split("\n")
                      .select { |tag| tag.start_with?(TAG_PREFIX) && !tag.strip.empty? }
                      .sort do |a, b|
                        pa = a.sub(TAG_PREFIX, "").split('.').map(&:to_i)
                        pb = b.sub(TAG_PREFIX, "").split('.').map(&:to_i)

                        # Desc order
                        (pb <=> pa)
                      end

    if tags.length < 2
      UI.user_error!("Not enough tags to determine latest and previous tags.")
    end

    latest = tags[0]
    previous = tags[1]

    UI.success("Latest Tag: #{latest}")
    UI.success("Previous Tag: #{previous}")

    return {
      latest_tag: latest,
      previous_tag: previous
    }
  rescue => e
    UI.user_error!("Error fetching Git tags: #{e.message}")
  end
end

# lark notification
def send_lark_notification(title:, version_name:, build_time:, download_url:, commit:, tags:)
  latest_tag = tags[:latest_tag]
  previous_tag = tags[:previous_tag]
  lark_message = {
    "msg_type" => "interactive",
    "card" => {
      "header" => {
        "title" => {
          "tag" => "plain_text",
          "content" => "#{title} 🚀"
        },
        "template" => "green"
      },
      "elements" => [
        {
          "tag" => "div",
          "text" => {
            "tag" => "lark_md",
            "content" => "🌟 App(Android): CA Wallet\n🌟 Version: #{version_name}\n📅 Build Time#{ENV['CI'] ? '(UTC)' : ''}: #{build_time}"
          }
        },
        # {
        #   "tag" => "action",
        #   "actions" => [
        #     {
        #       "tag" => "button",
        #       "text" => {
        #         "tag" => "plain_text",
        #         "content" => "Click here to download"
        #       },
        #       "type" => "primary",
        #       "url" => download_url
        #     }
        #   ]
        # },
        {
          "tag" => "action",
          "actions" => [
            {
              "tag" => "button",
              "text" => {
                "tag" => "plain_text",
                "content" => "Github Compare"
              },
              "type" => "primary",
              "url" => "https://github.com/Portkey-Wallet/portkey-wallet/compare/#{previous_tag}...#{latest_tag}"
            }
          ]
        }
      ]
    }
  }

  lark_webhook_url = LARK_WEBHOOK_URL
  unless lark_webhook_url
    UI.user_error!("LARK_WEBHOOK_URL is not set!")
  end

  uri = URI.parse(lark_webhook_url)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.verify_mode = OpenSSL::SSL::VERIFY_NONE
  request = Net::HTTP::Post.new(uri.request_uri, { 'Content-Type' => 'application/json' })
  request.body = lark_message.to_json
  response = http.request(request)

  if response.code.to_i >= 200 && response.code.to_i < 300
    UI.success("Lark notification sent successfully! 🚀")
  else
    UI.error("Failed to send Lark notification: #{response.code} - #{response.body}")
  end
end

# build & notification
def build_and_notify(track:, title:)
  # Upload and get download URL
  if track == "internal_sharing"
    download_url = upload_to_play_store_internal_app_sharing(
      package_name: "com.portkey.finance",
      json_key: ENV['GOOGLE_JSON_KEY_FILE'],
      aab: File.absolute_path('../app/build/outputs/bundle/release/app-release.aab'),
      )
  elsif track == "play_store"
    # --- Build APK ---
    gradle(
      task: "clean assemble",
      build_type: "Release",
      project_dir: "../android",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_FILE'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEYSTORE_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEYSTORE_PASSWORD']
        }
    )

    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    apk_file_name = File.basename(apk_path)
    UI.message "apk_path: #{apk_path}"
    UI.message "apk_file_name: #{apk_file_name}"

    # Build AAB file
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "../android",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_FILE'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEYSTORE_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEYSTORE_PASSWORD']
      }
    )
    upload_to_play_store(
      track: ENV['PLAY_STORE_TRACK'], # or alpha, beta
      release_status: "draft",
      json_key: ENV['GOOGLE_JSON_KEY_FILE'],
      aab: File.absolute_path('../app/build/outputs/bundle/release/app-release.aab'),
      sync_image_upload: true,
      skip_upload_apk: true
    )

    version_name = get_version_name("../app/build.gradle")
    # aab
    aab_path = File.absolute_path('../app/build/outputs/bundle/release/app-release.aab')
    aab_dir = File.dirname(aab_path)
    new_aab_name = "Portkey-Android-v#{version_name}.aab"
    new_aab_path = File.join(aab_dir, new_aab_name)
    # rename aab
    File.rename(aab_path, new_aab_path)
    UI.message("Renamed aab: #{new_aab_path}")

    # apk
    apk_dir = File.dirname(apk_path)
    new_apk_name = "Portkey-Android-v#{version_name}.apk"
    new_apk_path = File.join(apk_dir, new_apk_name)
    # rename apk
    File.rename(apk_path, new_apk_path)
    UI.message("Renamed apk: #{new_apk_path}")

  else
    UI.user_error!("Unsupported track: #{track}")
  end

  # get version info
  app_name = "Portkey Wallet"
  version_name = get_version_name("../app/build.gradle")
  build_time = get_timestamp
  commit = get_latest_commit
  tags = get_latest_and_previous_tag   # get tag

  # # send notification
  # send_lark_notification(
  #   title: title,
  #   app_name: app_name,
  #   version_name: version_name,
  #   build_time: build_time,
  #   download_url: download_url,
  #   commit: commit,
  #   tags: tags
  # )
end

default_platform(:android)
platform :android do
  desc 'build beta'
  lane :beta_local do
    # Adjust the `build_type` and `flavor` params as needed to build the right APK for your setup
    gradle(
      task: 'assemble',
      build_type: 'Release'
    )
  
    # ...
  end

  desc "Internal Sharing Upload Lane"
  lane :internal_sharing do
    build_and_notify(track: "internal_sharing", title: "Internal App Deployment")
  end

  desc "Google Play Store Deployment Lane"
  lane :deploy_to_play_store do
    build_and_notify(track: "play_store", title: "Play Store App Deployment")
  end

  desc "Echo details"
  lane :echo_deploy_to_play_store do
    app_name = "Portkey Wallet"
    version_name = get_version_name("../app/build.gradle")
    build_time = get_timestamp
    commit = get_latest_commit

    UI.message "Latest Commit ID: #{commit[:id]}"
    UI.message "Latest Commit Message: #{commit[:message]}"
    UI.message "App Name: #{app_name}"
    UI.message "Version Name: #{version_name}"
    UI.message "Build Time: #{build_time}"
    UI.message "KeyStore File: #{ENV['ANDROID_KEYSTORE_FILE']}"
  end
end
