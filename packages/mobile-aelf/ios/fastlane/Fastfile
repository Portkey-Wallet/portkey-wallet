# update_fastlane

default_platform(:ios)

DEVELOPER_APP_ID = ENV["DEVELOPER_APP_ID"]
DEVELOPER_APP_IDENTIFIER = ENV["DEVELOPER_APP_IDENTIFIER"]
PROVISIONING_PROFILE_SPECIFIER = ENV["PROVISIONING_PROFILE_SPECIFIER"]
TEMP_KEYCHAIN_USER = ENV[ "TEMP_KEYCHAIN_USER" ]
TEMP_KEYCHAIN_PASSWORD = ENV[ "TEMP_KEYCHAIN_PASSWORD" ]
APPLE_ISSUER_ID = ENV["APPLE_ISSUER_ID"]
APPLE_KEY_ID = ENV["APPLE_KEY_ID"]
APPLE_KEY_CONTENT = ENV["APPLE_KEY_CONTENT"]
GIT_AUTHORIZATION = ENV["GIT_AUTHORIZATION"]
DEVELOPER_PORTAL_TEAM_ID = ENV["DEVELOPER_PORTAL_TEAM_ID"]
LARK_WEBHOOK_URL = ENV['LARK_WEBHOOK_URL']
LARK_ROBOT = ENV['LARK_ROBOT']
TAG_PREFIX = "eoa.ios.v."


# We will download and store our keychain into a file
def delete_temp_keychain(name)
  delete_keychain(
    name: name
  ) if File.exist? File.expand_path("~/Library/Keychains/#{name}-db")
end
def create_temp_keychain(name, password)
  create_keychain(
    name: name,
    password: password,
    unlock: false,
    timeout: 0
  )
end
def ensure_temp_keychain(name, password)
  delete_temp_keychain(name)
  create_temp_keychain(name, password)
end
# the last commit id & commit msg
def get_latest_commit
  commit_id = `git log -1 --pretty=format:"%H"`.strip
  commit_message = `git log -1 --pretty=format:"%s"`.strip
  { id: commit_id, message: commit_message }
end
# get time stamp
def get_timestamp
  Time.now.strftime("%Y-%m-%d %H:%M:%S")
end
# get version name
def get_version_name(file_path)
  plist_content = File.read(file_path)
  version_name_match = plist_content.match(/<key>CFBundleShortVersionString<\/key>\s*<string>([\d.]+)<\/string>/)
  if version_name_match
    return version_name_match[1]
  else
    UI.user_error!("Could not find CFBundleShortVersionString in #{file_path}")
  end
end
# get latest and previous tag
def get_latest_and_previous_tag
  begin
    UI.message("Fetching tag list...")

    tags_output = sh("git tag")
    UI.message("All tags in repo:\n#{tags_output}")
    tags = tags_output.split("\n")
                      .select { |tag| tag.start_with?(TAG_PREFIX) && !tag.strip.empty? }
                      .sort do |a, b|
                        pa = a.sub(TAG_PREFIX, "").split('.').map(&:to_i)
                        pb = b.sub(TAG_PREFIX, "").split('.').map(&:to_i)

                        # Desc order
                        (pb <=> pa)
                      end

    if tags.length < 2
      UI.user_error!("Not enough tags to determine latest and previous tags.")
    end

    latest = tags[0]
    previous = tags[1]

    UI.success("Latest Tag: #{latest}")
    UI.success("Previous Tag: #{previous}")

    return {
      latest_tag: latest,
      previous_tag: previous
    }
  rescue => e
    UI.user_error!("Error fetching Git tags: #{e.message}")
  end
end

# lark notification
def send_lark_notification(title:, version_name:, build_time:, commit:, tags:)
  latest_tag = tags[:latest_tag]
  previous_tag = tags[:previous_tag]

  lark_message = {
    "msg_type" => "interactive",
    "card" => {
      "header" => {
        "title" => {
          "tag" => "plain_text",
          "content" => "#{title} 🚀"
        },
        "template" => "green"
      },
      "elements" => [
        {
          "tag" => "div",
          "text" => {
            "tag" => "lark_md",
            "content" => "🌟 App(iOS): EOA Wallet\n🌟 Version: #{version_name}\n📅 Build Time#{ENV['CI'] ? '(UTC)' : ''}: #{build_time}"
          }
        },
        {
          "tag" => "action",
          "actions" => [
            {
              "tag" => "button",
              "text" => {
                "tag" => "plain_text",
                "content" => "Github Compare"
              },
              "type" => "primary",
              "url" => "https://github.com/Portkey-Wallet/portkey-wallet/compare/#{previous_tag}...#{latest_tag}"
            }
          ]
        }
      ]
    }
  }
  
  lark_webhook_url = LARK_WEBHOOK_URL

  unless lark_webhook_url
    UI.user_error!("LARK_WEBHOOK_URL is not set!")
  end

  uri = URI.parse(lark_webhook_url)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.verify_mode = OpenSSL::SSL::VERIFY_NONE
  request = Net::HTTP::Post.new(uri.request_uri, { 'Content-Type' => 'application/json' })
  request.body = lark_message.to_json
  response = http.request(request)

  if response.code.to_i >= 200 && response.code.to_i < 300
    UI.success("Lark notification sent successfully! 🚀")
  else
    UI.error("Failed to send Lark notification: #{response.code} - #{response.body}")
  end
end


platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do

    # Create the KeyChain certaficate and install it
    ensure_temp_keychain(TEMP_KEYCHAIN_USER, TEMP_KEYCHAIN_PASSWORD)

    # access to App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: APPLE_KEY_ID,
      issuer_id: APPLE_ISSUER_ID,
      key_content: APPLE_KEY_CONTENT,
      duration: 1200,
      in_house: false
     )


     update_code_signing_settings(
      use_automatic_signing: false,
      path: "AELFWallet.xcodeproj",
      team_id: "#{DEVELOPER_PORTAL_TEAM_ID}",
      targets: "AELFWallet",
      build_configurations: ["Release", "Debug"],
      code_sign_identity: "Apple Distribution: YIMU TECHNOLOGY CO., LIMITED (#{DEVELOPER_PORTAL_TEAM_ID})",
      profile_name: PROVISIONING_PROFILE_SPECIFIER,
      bundle_identifier: DEVELOPER_APP_IDENTIFIER
    )

      # get the certaficates from the Github account
      match(
          type: 'appstore',
          app_identifier: "#{DEVELOPER_APP_IDENTIFIER}",
          git_basic_authorization: Base64.strict_encode64(GIT_AUTHORIZATION),
          readonly: true,
          keychain_name: TEMP_KEYCHAIN_USER,
          keychain_password: TEMP_KEYCHAIN_PASSWORD,
          api_key: api_key
      )

    latest_build_number = latest_testflight_build_number(
      app_identifier: DEVELOPER_APP_IDENTIFIER,
      api_key: api_key
    )
    latest_build_number = latest_build_number.nil? ? 0 : latest_build_number


    increment_build_number(
      xcodeproj: "AELFWallet.xcodeproj",
      build_number: latest_build_number.to_i + 1
    )

    # Build the App
    ipa = gym(
      configuration: "Release",
      xcargs: "-jobs 4",
      export_xcargs: "-allowProvisioningUpdates",
      workspace: 'AELFWallet.xcworkspace',
      scheme: "AELFWallet",
      export_method: "app-store",
      export_options: {
      provisioningProfiles: {
          DEVELOPER_APP_ID => PROVISIONING_PROFILE_SPECIFIER
      }
    })


    #Ship to TestFlight
    pilot(
      apple_id: "#{DEVELOPER_APP_ID}",
      app_identifier: "#{DEVELOPER_APP_IDENTIFIER}",
      distribute_external: true,
      notify_external_testers: true,
      uses_non_exempt_encryption: false,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      verbose: true,
      changelog: "Build #{Time.now.strftime('%Y.%m.%d')}: Regular update and improvements"
     )


       # get version info
      title = "TestFlight Push Notification "
      version_name = get_version_name("../AELFWallet/info.plist")
      build_time = get_timestamp
      commit = get_latest_commit
      tags = get_latest_and_previous_tag   # get tag
      build_num = latest_build_number.to_i + 1
      version_name_with_build = "#{version_name}-#{build_num}"

      send_lark_notification(
        title: title,
        version_name: version_name_with_build,
        build_time: build_time,
        commit: commit,
        tags: tags
      )

      # ===== Rename IPA & dSYM =====
      ipa_path = ipa 
      ipa_dir = File.dirname(ipa_path)

      new_ipa_name = "FairyVault-iOS-v#{version_name}.ipa"
      new_ipa_path = File.join(ipa_dir, new_ipa_name)

      # rename ipa
      File.rename(ipa_path, new_ipa_path)
      UI.message("Renamed IPA: #{new_ipa_path}")

      # rename dSYM
      dsym_path = ipa_path.sub(".ipa", ".app.dSYM.zip")
      if File.exist?(dsym_path)
        new_dsym_name = "FairyVault-iOS-v#{version_name}.dSYM.zip"
        new_dsym_path = File.join(ipa_dir, new_dsym_name)
        File.rename(dsym_path, new_dsym_path)
        UI.message("Renamed dSYM: #{new_dsym_path}")
      else
        UI.message("No dSYM file found to rename")
      end

  end
end
